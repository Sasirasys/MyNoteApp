extends baseLayout 

block content
    div#login-form
        h1 Welcome to MyNote!
        div
            label Username:
            input(type="text", id="username", name="username")
        div
            label Password:
            input(type="password", id="password", name="password")
        div
            button(onclick="signUp(document.getElementById('username').value, document.getElementById('password').value)")#signup-button Sign up
            button#login-button Login
        #login-message= message
        script(src="/js/main.js")