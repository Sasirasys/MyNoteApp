extends baseLayout 

block content
    form#login-form
        h1 Welcome to MyNote!
        div
            label Username:
            input(type="text", id="username", name="username")
        div
            label Password:
            input(type="password", id="password", name="password")
        div
            button(type="submit")#signup-button Sign up
            button(type="submit")#login-button Login
        